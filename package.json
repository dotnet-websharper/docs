{
  "name": "websharper-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "prep": "npx esbuild source.config.ts --platform=node --outfile=.source/source.config.mjs --format=esm",
    "dev": "npm run prep && cd snippets && npm install && cd ../ && dotnet build snippets/snippets.sln -c Release && node customServer.mjs",
    "start": "next start",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "fumadocs-core": "15.2.12",
    "fumadocs-mdx": "11.6.1",
    "fumadocs-ui": "15.2.12",
    "next": "^15.5.12",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.7",
    "@types/mdx": "^2.0.13",
    "@types/node": "22.15.2",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "eslint": "^8",
    "eslint-config-next": "15.3.1",
    "mime": "^4.0.7",
    "postcss": "^8.5.3",
    "postcss-nesting": "^13.0.1",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3"
  }
}
