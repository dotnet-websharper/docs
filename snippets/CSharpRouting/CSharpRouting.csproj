<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="package.json" />
    <None Include="wsconfig.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WebSharper" Version="9.1.7.598" />
    <PackageReference Include="WebSharper.CSharp" Version="9.1.7.598" />
    <PackageReference Include="WebSharper.UI" Version="9.1.7.598" />
    <PackageReference Include="WebSharper.UI.CSharp" Version="9.1.7.598" />
    <PackageReference Include="WebSharper.AspNetCore" Version="9.1.7.598" />
  </ItemGroup>

  <Target Name="ESBuildBundle" AfterTargets="WebSharperCompile" Condition=" '$(Configuration)' == 'Release' ">
    <Exec Command="npm install" />
    <Exec Command="node ./esbuild.config.mjs" />
  </Target>

</Project>